# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ─── Cloudinary (free image & logo storage) ─────────────────────────────────
# 1. Sign up free at https://cloudinary.com
# 2. Dashboard → Settings → Upload → Upload Presets → Add Preset
#    → Signing Mode = "Unsigned" → Save
# 3. Fill in your Cloud Name (shown on dashboard) and the preset name you created.
#
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name_here
